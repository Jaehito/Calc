<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseLogger">

        <!-- 진짜 진입점. 구글 로그인이 없으면 여기서 막고, 있으면 곧장 홈으로 넘긴다 (Compose). -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            첫 시작 — 월급에서 고정비를 빼 챌린지 금액을 정한다.
            로그인 뒤 한 번, 그리고 홈·설정의 «고정비로 계산하기»로 다시 들어온다.
        -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize" />

        <!-- 곳간 숫자를 보여주는 메인 화면. 로그인 뒤에만 들어온다 (Compose). -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!--
            내보낸 CSV 를 공유 시트로 건네기 위한 창구. 앱 전용 캐시의 export/ 폴더만 연다
            (res/xml/file_paths.xml). exported=false 라 다른 앱이 스스로 열 수 없고,
            공유할 때 우리가 준 권한으로만 읽힌다.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 주기 리포트. 결산 팝업과 통계 탭 두 곳에서 들어온다. -->
        <activity
            android:name=".CycleReportActivity"
            android:exported="false"
            android:label="지난 주기 리포트"
            android:parentActivityName=".HomeActivity" />

        <!-- 카테고리 하나를 이름별로 펼치고 다시 분류하는 화면. 통계 도넛과 리포트 막대에서 들어온다. -->
        <activity
            android:name=".CategoryDetailActivity"
            android:exported="false"
            android:label="카테고리"
            android:parentActivityName=".HomeActivity" />

        <!-- 곳간 내역. 홈의 곳간 카드에서만 들어온다. -->
        <activity
            android:name=".PurseHistoryActivity"
            android:exported="false"
            android:label="내역"
            android:parentActivityName=".HomeActivity" />

        <!-- 설정. 홈의 «설정» 에서만 들어온다. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="설정"
            android:parentActivityName=".HomeActivity"
            android:windowSoftInputMode="adjustResize" />

        <!--
            알림 카드를 누르면 뜨는 빠른 입력 화면.
            showWhenLocked 로 잠금 해제 없이 뜨도록 요청한다 (제조사 정책이 막을 수 있다).
        -->
        <activity
            android:name=".QuickInputActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:theme="@style/Theme.ExpenseLogger.QuickInput"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible" />

        <!-- 알림이 지워지면 되살린다. 앱에서 끈 경우에는 되살리지 않는다. -->
        <receiver
            android:name=".DismissReceiver"
            android:exported="false" />

        <!-- 잠금화면 알림의 인라인 답장을 받는다. 외부 앱이 부를 이유가 없으므로 exported=false. -->
        <receiver
            android:name=".ReplyReceiver"
            android:exported="false" />

        <!--
            결제 알림을 읽어 «적었어?» 리마인더를 예약하는 서비스.
            사용자가 설정에서 «알림 접근»을 직접 허용해야만 동작한다. 금액은 저장하지 않는다.
        -->
        <service
            android:name=".PaymentNotificationListener"
            android:exported="false"
            android:label="지출 기록 리마인더"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
