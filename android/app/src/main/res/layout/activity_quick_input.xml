<?xml version="1.0" encoding="utf-8"?>
<!-- 기록 창. 알림 카드·잠금화면·홈의 연필을 누르면 이 화면이 뜬다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        창의 **위쪽 가장자리를 화면 위에 고정**하고 바닥까지 채운다(위 여백은 코드가 상태 표시줄
        높이 + 24dp 로 준다). 예전에는 아래에 붙고 높이가 내용만큼이라, 한 건 적을 때마다 창이
        위로 자라고 키보드가 뜨고 질 때마다 창 전체가 키보드 높이만큼 오르내려 숫자·입력 칸을
        매번 다시 찾아야 했다.

        키보드는 창을 밀지 않고 아래쪽을 덮는다. 키보드 높이는 스크롤의 아래 여백으로만 받아
        (clipToPadding=false) 가려진 격자·방금 적은 목록을 키보드 위에서 스크롤해 볼 수 있다.
    -->
    <ScrollView
        android:id="@+id/sheetScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet"
        android:clipToPadding="false"
        android:fillViewport="true">

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!--
            맨 위 줄: 나무에 줄 물(오른쪽, W2). 물 칸을 누르면 말풍선이 뜬다(코드).
            개인·공용은 입력 칸 안 왼쪽 알약([chipPurse])에서 고른다 — 맨 위는 엄지에서 멀어 잘못 누르기 쉬웠다.
        -->
        <LinearLayout
            android:id="@+id/rowTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 저장하면 «+1» 이 물 칸 위로 떠오른다. 그래서 둘을 겹쳐 둔다. -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/groupWater"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_water_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_water_drop" />

                    <TextView
                        android:id="@+id/textWater"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:fontFeatureSettings="tnum"
                        android:text="0"
                        android:textColor="@color/water"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textWaterPlus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:text="+1"
                    android:textColor="@color/water"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘 쓸 수 있는 돈"
            android:textColor="@color/app_ink_2"
            android:textSize="13.5sp" />

        <!-- 홈 카드와 같은 숫자. 한국어는 «원»을 작게 따로, 다른 언어는 ₩ 를 숫자 앞에 붙인다. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textAvailable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figures_bold"
                android:letterSpacing="-0.02"
                android:text="—"
                android:textColor="@color/app_accent"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/textUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="원"
                android:textColor="@color/app_ink_2"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/textPeriod"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/figures_regular"
                android:textColor="@color/app_ink_2"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/textDaysLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/app_accent"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/barCycle"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progressDrawable="@drawable/bg_cycle_bar"
            android:visibility="gone" />

        <!-- 처음 세 번만 뜨는 안내. «알겠어요» 를 누르면 다시 안 뜬다(코드). -->
        <LinearLayout
            android:id="@+id/groupTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tip"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/textTip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/app_card"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/buttonTipOk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp"
                    android:textColor="@color/app_bright"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="14dp"
                android:layout_height="7dp"
                android:layout_marginStart="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tip_pointer" />
        </LinearLayout>

        <!--
            입력 칸 하나 + 칸 안 오른쪽의 기록 버튼. 금액 부분은 칸 안에서 초록 알약으로 그린다.
            지갑이 둘이면 칸 안 왼쪽에 «개인 ⇄» 알약이 붙는다 — 누를 때마다 개인↔공용(코드).
        -->
        <FrameLayout
            android:id="@+id/groupInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <com.calc.expense.AmountEditText
                android:id="@+id/inputExpense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:background="@drawable/bg_input"
                android:hint="예: 커피 4500"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:maxLines="1"
                android:minHeight="52dp"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="56dp"
                android:paddingBottom="12dp"
                android:textColor="@color/app_ink"
                android:textColorHint="@color/app_muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/chipPurse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_purse_chip"
                android:minHeight="38dp"
                android:gravity="center"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:text="개인 ⇄"
                android:textColor="@color/app_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/buttonSend"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_send"
                android:contentDescription="기록"
                android:enabled="false"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_up"
                app:tint="@color/app_card" />
        </FrameLayout>

        <!--
            입력 칸 아래 한 줄 자리. 늘 보이게 두어(비어 있어도) 글자가 생기고 사라져도 아래가 밀리지 않는다.
            적는 중에는 «기록하면 오늘 N원 남아요», 기록·삭제·실패 뒤에는 그 결과가 같은 자리에 뜬다.
        -->
        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/figures_medium"
            android:minLines="1"
            android:textColor="@color/app_ink_2"
            android:textSize="12.5sp" />

        <!--
            카테고리 격자. 한 줄에 다섯 칸, 칸은 코드에서 목록만큼 만든다(item_category_cell).
            «미분류» 가 맨 앞이고 기본으로 켜져 있다.
        -->
        <GridLayout
            android:id="@+id/groupCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="5"
            android:useDefaultMargins="false" />

        <!-- 이번에 적은 항목들. 첫 항목이 생기면 위에 가는 선과 제목이 보인다. -->
        <LinearLayout
            android:id="@+id/groupRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/app_line" />

            <TextView
                android:id="@+id/textRecentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/app_muted"
                android:textSize="11.5sp" />

            <LinearLayout
                android:id="@+id/listEntries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</FrameLayout>
