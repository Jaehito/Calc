<?xml version="1.0" encoding="utf-8"?>
<!-- 아래에 붙는 입력 카드. 알림 카드를 누르면 이 화면이 뜬다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/textCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘 쓸 수 있는 돈"
            android:textColor="@color/app_ink_2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textAvailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="—"
            android:textColor="@color/app_ink"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textBreakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/app_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/inputExpense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:autofillHints=""
            android:background="@drawable/bg_input"
            android:hint="예: 커피 4500"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingTop="13dp"
            android:paddingEnd="14dp"
            android:paddingBottom="13dp"
            android:textColor="@color/app_ink"
            android:textColorHint="@color/app_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textCategoryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="카테고리 (선택)"
            android:textColor="@color/app_muted"
            android:textSize="11sp" />

        <!--
            여러 줄로 펼친다(singleLine=false) — 시트 아래 여백이 넉넉해 가로 스크롤보다
            한눈에 다 보이는 편이 고르기 쉽다. «없음» 칩이 항상 맨 앞(코드에서 addView 순서).
        -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:chipSpacingHorizontal="7dp"
            app:chipSpacingVertical="7dp"
            app:singleLine="false"
            app:singleSelection="true"
            app:selectionRequired="true" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/groupPurse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPursePersonal"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="개인" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPurseShared"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="공용" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- 방금 한 동작의 짧은 알림 (기록 중 · 실패 · 삭제됨). 한 줄로 갱신해 높이가 출렁이지 않게. -->
        <TextView
            android:id="@+id/textResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 이번에 적은 항목들. 각 줄 오른쪽 ✕ 로 방금 적은 걸 바로 지운다. -->
        <LinearLayout
            android:id="@+id/listEntries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
