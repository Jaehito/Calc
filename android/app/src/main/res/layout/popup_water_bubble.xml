<?xml version="1.0" encoding="utf-8"?>
<!--
    기록 창 💧 칸 말풍선. 누르면 나무 탭으로 간다(코드). 꼬리는 오른쪽 끝 가까이에 두어
    오른쪽 위 💧 칸을 가리킨다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubbleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:layout_width="14dp"
        android:layout_height="7dp"
        android:layout_gravity="end"
        android:layout_marginEnd="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_bubble_tail" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_water_bubble"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="10dp"
        android:paddingEnd="13dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/textBubble"
            android:layout_width="wrap_content"
            android:maxWidth="260dp"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text="물방울을 누르면 나무에게 물을 줄 수 있어요!"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textBubbleSub"
            android:layout_width="wrap_content"
            android:maxWidth="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="지금 7방울 · 나무 탭에서 주기 ›"
            android:textColor="@color/bubble_sub"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
