<?xml version="1.0" encoding="utf-8"?>
<!--
    결제 팝업([PaymentOverlay]). 다른 앱 위, 화면 아래(토스트 자리)에 5초 뜬다.
    글자는 코드에서 채운다 — 언어를 따라야 한다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlayCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_payment"
    android:elevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="13dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_overlay_badge"
            android:gravity="center"
            android:text="₩"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/overlayTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="₩4,500 · 스타벅스" />

            <TextView
                android:id="@+id/overlayAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#9FE3C8"
                android:textSize="12sp"
                tools:text="눌러서 기록" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="›"
            android:textColor="#9FE3C8"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- 남은 시간. 5초 동안 오른쪽에서 왼쪽으로 줄어든다. -->
    <View
        android:id="@+id/overlayTimer"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:background="@color/app_accent" />
</FrameLayout>
